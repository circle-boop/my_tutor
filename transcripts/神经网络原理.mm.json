    "ocr_text": "",
    "formula_latex": [],
    "chart_data": [],
    "scene_type": "unknown",
    "visual_confidence": 0.0,
    "has_visual": false
  },
  {
    "start": 492.8,
    "end": 497.8,
    "text": "这就是神经网络中最常用的优化算法,踢肚下降。",
