# ===== LLM / VLM 配置 =====
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.siliconflow.cn/v1

# 实时问答 / 评估
CHAT_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
EVALUATE_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# 离线题目生成
QUIZ_MODEL_NAME=Qwen/Qwen2.5-14B-Instruct

# 视觉模型（图表/公式）
VLM_MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct
ENABLE_VLM=true

# 关键帧与多模态融合参数
KEYFRAME_MIN_INTERVAL_SEC=2
KEYFRAME_DIFF_THRESHOLD=18
KEYFRAME_MAX_PER_VIDEO=300
MM_MERGE_WINDOW_SEC=3

# ===== 本地模型路径 =====
EMBEDDING_MODEL_PATH=D:\AI_Models\AI-ModelScope\bge-small-zh-v1.5
WHISPER_MODEL_PATH=D:\AI_Models\faster-whisper-base

# ===== 数据路径（可按需改） =====
VIDEO_DIR=videos
TRANSCRIPT_DIR=transcripts
SUPPLEMENTARY_DOCS_DIR=supplementary_docs
CHROMA_DB_DIR=chroma_db
KEYFRAME_DIR=keyframes
VISUAL_CAPTION_DIR=visual_captions
DB_PATH=tutor_database.db

# ===== API 服务 =====
API_HOST=127.0.0.1
API_PORT=8000
# 用英文逗号分隔多个来源
CORS_ALLOW_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501,null
